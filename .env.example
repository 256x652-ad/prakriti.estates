# ==============================================================================
# PRAKRITI ESTATES & CONSULTANTS - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In CI/CD and Production (Vercel/AWS), set these variables in the secret store.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development # development | test | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE POSTGRESQL + POSTGIS)
# ------------------------------------------------------------------------------
# Transaction pooler URL (PgBouncer - Port 6543) used for queries in runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=15"

# Direct connection URL (Session - Port 5432) used for Prisma migrations & schema changes
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE, LOCKS & QUEUES (UPSTASH / REDIS)
# ------------------------------------------------------------------------------
# High performance Redis for ConfigurationService, Feature Flags & BullMQ queues
REDIS_URL="redis://default:[PASSWORD]@[HOST].upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (NEXTAUTH / JWT)
# ------------------------------------------------------------------------------
# Random 32+ character string: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-random-hex-key-minimum-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# JWT Token Secrets for Mobile API Clients (Task 27)
JWT_ACCESS_SECRET="mobile-access-token-jwt-secret-key-32-chars"
JWT_REFRESH_SECRET="mobile-refresh-token-jwt-secret-key-32-chars"

# ------------------------------------------------------------------------------
# 5. GEOSPATIAL & MAPS (MAPBOX GL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUwMDAwMHJ0ZXhwbGUwMDAwIn0.example"

# ------------------------------------------------------------------------------
# 6. PAYMENTS & ESCROW (RAZORPAY)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 7. SECURE OBJECT STORAGE (AWS S3)
# ------------------------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_S3_PUBLIC_BUCKET="prakriti-estates-public-assets"
AWS_S3_PRIVATE_BUCKET="prakriti-estates-private-kyc-docs"

# ------------------------------------------------------------------------------
# 8. IDENTITY VERIFICATION & KYC PROVIDERS
# ------------------------------------------------------------------------------
SUREPASS_API_KEY="surepass_live_placeholder_token"
SUREPASS_API_BASE_URL="https://kyc.surepass.io/api/v1"

# ------------------------------------------------------------------------------
# 9. NOTIFICATIONS & BROADCAST (EXPO / WHATSAPP / SES)
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN="placeholder_expo_push_token"
WHATSAPP_BUSINESS_API_TOKEN="placeholder_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="placeholder_phone_number_id"
NOTIFICATION_FROM_EMAIL="noreply@prakritiestates.com"

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & INCIDENT ALERTING (SENTRY & ON-CALL)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://placeholder@o123456.ingest.sentry.io/123456"
NEXT_PUBLIC_SENTRY_DSN="https://placeholder@o123456.ingest.sentry.io/123456"
SENTRY_ORG="prakriti-estates"
SENTRY_PROJECT="prakriti-web"
SENTRY_AUTH_TOKEN="sntrys_placeholder_token_for_sourcemap_uploads"

# On-Call Watchdog Alerting
SLACK_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXXX"
PAGERDUTY_ALERT_WEBHOOK_URL="https://events.pagerduty.com/v2/enqueue"
PAGERDUTY_ROUTING_KEY="placeholder_pagerduty_routing_key"
